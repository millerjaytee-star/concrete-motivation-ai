NEXT_PUBLIC_SITE_URL=https://concretemotivation.com
NEXT_PUBLIC_YOUTUBE_URL=https://youtube.com/@concretemotivation444
NEXT_PUBLIC_APP_URL=https://app.concretemotivation.com
NEXT_PUBLIC_BOOKING_URL=https://concretemotivation.com/speaking
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/concretemotivation444
NEXT_PUBLIC_TIKTOK_URL=https://tiktok.com/@concretemotivation444
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/concretemotivation

# Server-only. Never expose these through NEXT_PUBLIC_* variables.
STRIPE_SECRET_KEY=replace_with_restricted_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_webhook_signing_secret
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace_with_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_only_service_role_key
STRIPE_WEBHOOK_EVENTS_TABLE=stripe_webhook_events

# Select the existing Supabase staging project for this workspace.
COMMAND_SUPABASE_URL=
COMMAND_SUPABASE_PUBLISHABLE_KEY=
COMMAND_SUPABASE_SERVICE_KEY=
COMMAND_OWNER_ID=
# Optional when reverse proxy and browser origins differ.
COMMAND_ORIGIN=

# OpenAI server credentials. Enable only on the approved project.
OPENAI_API_KEY=
COMMAND_OPENAI_MODEL=gpt-4.1-mini

# Existing Composio project, provider-specific read scopes and identity binding.
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=
COMPOSIO_GOOGLE_ACCOUNT_EMAIL=
COMPOSIO_YOUTUBE_CHANNEL_ID=
COMPOSIO_GMAIL_AUTH_CONFIG_ID=
COMPOSIO_GOOGLECALENDAR_AUTH_CONFIG_ID=
COMPOSIO_GOOGLEDRIVE_AUTH_CONFIG_ID=
COMPOSIO_YOUTUBE_AUTH_CONFIG_ID=
# Set only when choosing a specific matching active connection.
COMPOSIO_GMAIL_CONNECTED_ACCOUNT_ID=
COMPOSIO_GOOGLECALENDAR_CONNECTED_ACCOUNT_ID=
COMPOSIO_GOOGLEDRIVE_CONNECTED_ACCOUNT_ID=
COMPOSIO_YOUTUBE_CONNECTED_ACCOUNT_ID=

# Optional scheduler. HTTPS origin of the environment being scheduled.
COMMAND_SCHEDULER_ORIGIN=
COMMAND_CRON_SECRET=
